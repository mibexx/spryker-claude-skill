<?xml version="1.0"?>
<transfers xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns="spryker:transfer-01"
           xsi:schemaLocation="spryker:transfer-01 http://static.spryker.com/transfer-01.xsd">

    <transfer name="ProductBadgesBackendApiAttributes">
        <property name="idProductBadge" type="int"/>
        <property name="fkProductAbstract" type="int"/>
        <property name="badgeKey" type="string"/>
        <property name="label" type="string"/>
    </transfer>

    <transfer name="ProductBadge" strict="true">
        <property name="idProductBadge" type="int"/>
        <property name="fkProductAbstract" type="int"/>
        <property name="badgeKey" type="string"/>
        <property name="label" type="string"/>
    </transfer>

    <transfer name="ProductBadgeCollection" strict="true">
        <property name="productBadges" type="ProductBadge[]" singular="productBadge"/>
    </transfer>

    <transfer name="ProductBadgeCriteria" strict="true">
        <property name="badgeKeys" type="string[]" singular="badgeKey"/>
    </transfer>

    <transfer name="GlueRequest"/>

    <transfer name="GlueResponse"/>

    <transfer name="GlueResource"/>

    <transfer name="GlueError"/>

    <transfer name="GlueResourceMethodCollection"/>

    <transfer name="GlueResourceMethodConfiguration"/>

</transfers>
